{
  "name": "nest-vue-learning",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:backend": "npm install --prefix nest-learning",
    "install:frontend": "npm install --prefix vue-learning",
    "install:all": "npm run install:backend && npm run install:frontend",

    "build:backend": "npm run build --prefix nest-learning",
    "build:frontend": "npm run build --prefix vue-learning",
    "build": "npm run build:frontend && npm run build:backend",

    "start": "npm run start:prod --prefix nest-learning",

    "prisma:migrate": "npx prisma migrate deploy --schema=nest-learning/prisma/schema.prisma"
  }
}
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql" 
}

model User {
  id        String   @id @default(cuid())
  username  String?
  email     String   @unique
  password  String?
  profileImage String?

  googleId String? @unique 


  role      UserRole @default(USER)
  settings     UserSettings?


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  videos Video[]
  googleAuthCodes GoogleAuthCode[]
  notifications Notification[]
}

model GoogleAuthCode {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([userId])
}

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String
  title   String
  message String
  data    Json?
  readAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, readAt, createdAt])
}

enum UserRole {
  USER
  ADMIN
}

model Video {
  id       String @id @default(cuid())
  filename String
  path     String
  mimetype String
  size     Int
  duration Float?
  type     VideoType @default(VIDEO)

  status       VideoStatus @default(UPLOADED)
  errorMessage String?

  parentVideoId String?
  parentVideo   Video?  @relation("VideoDerivatives", fields: [parentVideoId], references: [id], onDelete: Cascade)
  derivedVideos Video[] @relation("VideoDerivatives")

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  audio     Audio[]
  subtitles Subtitle[]
  jobs      SubtitleJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([parentVideoId])
}

model Subtitle {
  id       String  @id @default(cuid())
  filename String
  mimeType String
  path     String
  size     Int
  duration Float?

  languageCode   String
  subtitleFormat SubtitleFormat @default(SRT)

  videoId String
  video   Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([videoId])
}

model Audio {
  id       String  @id @default(cuid())
  filename String
  path     String
  mimetype String
  size     Int
  duration Float?

  videoId String
  video   Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([videoId])
}

model SubtitleJob {
  id String @id @default(cuid())

  queueJobId String?  @unique

  videoId String
  video   Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  status       JobStatus @default(PENDING)
  languageCode String?
  errorMessage String?

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([videoId])
}

enum SubtitleFormat {
  SRT
  VTT
}

enum VideoStatus {
  UPLOADED
  PROCESSING
  COMPLETED
  FAILED
}

enum VideoType {
  VIDEO
  BURNED_VIDEO
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}


model UserSettings {
  id        String   @id @default(cuid())

  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // General
  language      String   @default("en")
  theme         String   @default("dark")
  compactView   Boolean  @default(false)

  // Subtitle
  defaultLanguage   String   @default("en")
  defaultFormat     SubtitleFormat @default(SRT)
  autoPunctuation   Boolean  @default(true)
  wordLevelTiming   Boolean  @default(false)
  autoTranslate     Boolean  @default(false)
  translateLanguage String?

  // Subtitle style
  fontSize          Int      @default(32)
  fontColor         String   @default("#FFFFFF")
  backgroundOpacity Int      @default(50)
  position          String   @default("bottom")
  outline           Boolean  @default(true)

  // Notifications
  jobComplete       Boolean  @default(true)
  jobFailed         Boolean  @default(true)
  weeklyReport      Boolean  @default(false)
  productUpdates    Boolean  @default(true)
  marketing         Boolean  @default(false)

  // Download
  autoDownload      Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

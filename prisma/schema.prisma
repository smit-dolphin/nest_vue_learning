generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  videos    Video[]
}

model Video {
  id        String      @id @default(cuid())
  filename  String
  path      String
  mimetype  String
  size      Int
  duration  Float?

  status    VideoStatus @default(UPLOADED)

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  audio Audio[]
  subtitle Subtitle[]

  userId    String
  user      User        @relation(fields: [userId], references: [id])
}

model Subtitle{
  id String @id @default(cuid())
  filename String
  mimeType String
  path String
  size Int
  duration Float? 

  subtitleFormat SubtitleFormat @default(SRT) 

  videoId String
  video Video @relation(fields:[videoId],references:[id])
  
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

}

enum SubtitleFormat {
  SRT
  VTT
}

enum VideoStatus {
  UPLOADED
  PROCESSING
  COMPLETED
  FAILED
}


model Audio{
  id String @id @default(cuid())
  filename String
  path String
  mimetype String
  size Int
  duration Float?

  videoId String
  video Video @relation(fields:[videoId],references:[id])


  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

}